{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DornGuard configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "profiles": { "$ref": "#/$defs/profiles" },
    "rules": { "$ref": "#/$defs/rules" },
    "java_target": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "java_source": { "type": "integer", "minimum": 3, "maximum": 27 },
    "allow_logged_exceptions": { "type": "boolean", "default": false },
    "java_resource_owners": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "java_managed_resource_factories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "thymeleaf_partial_parsing": { "enum": ["error", "warning"], "default": "error" },
    "thymeleaf_sanitizers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^@[A-Za-z_$][A-Za-z0-9_$]*\\.[A-Za-z_$][A-Za-z0-9_$]*$" }
    },
    "exclude": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceGlob" }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "java_indent": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4 },
        "kotlin_indent": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4 },
        "javascript_indent": { "type": "integer", "minimum": 1, "maximum": 16, "default": 2 },
        "line_ending": { "enum": ["lf", "crlf"], "default": "lf" },
        "max_blank_lines": { "type": "integer", "minimum": 0, "maximum": 255, "default": 1 },
        "indent_style": { "enum": ["spaces", "tabs"], "default": "spaces" },
        "control_spacing": { "enum": ["space", "none"], "default": "space" },
        "include_minified": { "type": "boolean", "default": false },
        "exclude": { "type": "array", "items": { "$ref": "#/$defs/sourceGlob" } },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["files"],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/sourceGlob" }
              },
              "indent_size": { "type": "integer", "minimum": 1, "maximum": 16 },
              "line_ending": { "enum": ["lf", "crlf"] },
              "max_blank_lines": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "dependentRequired": { "fingerprint": ["rule"] },
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "reason": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "ruleset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "const": "builtin" },
            "version": { "const": "1.4.0" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path"],
          "properties": {
            "source": { "const": "local" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "repository", "ref"],
          "properties": {
            "source": { "const": "git" },
            "repository": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "modules": {
      "type": "object",
      "propertyNames": { "pattern": "^(?::|[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$)" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profiles": { "$ref": "#/$defs/profiles" },
          "rules": { "$ref": "#/$defs/rules" }
        }
      }
    },
    "module_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbid": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "pattern": "^:" },
              "to": { "type": "string", "pattern": "^:" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceGlob": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "severity": { "enum": ["warning", "error"] },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              { "required": ["forbidden"], "not": { "required": ["cycles"] } },
              { "required": ["cycles"], "not": { "required": ["forbidden"] } }
            ],
            "properties": {
              "from": { "type": "array", "items": { "type": "string" } },
              "forbidden": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "cycles": { "const": true }
            }
          }
        }
      }
    }
  }
}
